<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_brewery" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.rdl.packaging</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="rdl_packaging" string="Packaging">
                    <group>
                        <group string="Pack UoM" name="group_pack_uom">
                            <field name="pack_qty"/>
                            <field name="pack_uom_type"/>
                            <div colspan="2" class="text-muted">
                                Set Units per Pack above 1 to use a pack as the main UoM
                                (e.g. Crate x24). On a sale/purchase line, change UoM to Bottle
                                or Can and Odoo converts price and stock automatically.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
