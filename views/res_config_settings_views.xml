<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Overwrite obsolete deposit-settings inherit that referenced
        brewery_default_* fields (removed from res.config.settings).
        Must load before other settings inherits so upgrade does not crash.
    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rdl</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <!-- deposit defaults removed; view kept inactive for xmlid stability -->
            </xpath>
        </field>
    </record>
</odoo>
